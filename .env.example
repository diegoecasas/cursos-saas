# Anthropic API key para el docente digital y el Director de Cursos.
# Obtén una en https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# kie.ai — fotos/video fotorrealistas (Hook, CTA, ciclo de pasos).
# Obtén una en https://kie.ai
KIE_API_KEY=...

# Modal — narración del Director de Cursos (OmniVoice en GPU).
# Deploy: cd modal-app && .venv/bin/modal deploy narration_app.py
MODAL_NARRATION_URL=https://<workspace>--director-narration-generate.modal.run
NARRATION_SHARED_SECRET=...

# El resto (DATABASE_URL, CLERK_*, BLOB_READ_WRITE_TOKEN, POSTGRES_*) se
# obtiene con `vercel env pull` una vez el proyecto está linkeado — no hace
# falta configurarlo a mano.
